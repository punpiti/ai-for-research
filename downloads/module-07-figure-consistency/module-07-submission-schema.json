{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urban.cpe.ku.ac.th/ai-for-research/schemas/module-07-highlights.v1.json",
  "title": "AI for Research Module 7 Highlights Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "submission_id", "class_code", "callsign", "callsign_key", "client_submitted_at", "artifact"],
  "properties": {
    "event_type": {"const": "ai_for_research_module_7_highlights"},
    "submission_id": {"type": "string", "format": "uuid"},
    "class_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$"},
    "callsign": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$"},
    "callsign_key": {"type": ["string", "null"]},
    "client_submitted_at": {"type": "string", "format": "date-time"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "markdown", "highlight_count", "chart_count", "ai_used", "evidence_confirmed", "conclusion_confirmed", "no_sensitive_data_confirmed"],
      "properties": {
        "filename": {"const": "module-07-highlights.md"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "markdown": {"type": "string", "minLength": 400, "maxLength": 65536},
        "highlight_count": {"type": "integer", "minimum": 3, "maximum": 5},
        "chart_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "ai_used": {"enum": ["yes", "no"]},
        "evidence_confirmed": {"const": true},
        "conclusion_confirmed": {"const": true},
        "no_sensitive_data_confirmed": {"const": true}
      }
    }
  }
}
